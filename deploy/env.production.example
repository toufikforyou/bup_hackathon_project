# =============================================================================
# Production environment template — copy to .env.production on the VM and fill
# in the secrets. This file IS read by docker-compose, so it must live on the
# host but NEVER be committed to git. Add `.env.production` to .gitignore.
# =============================================================================

# --- Core Laravel ---
APP_NAME=GridOptima
APP_ENV=production
APP_DEBUG=false
APP_URL=https://hackathon.buddy.bd

# 32-byte base64 key. Generate one with:
#   openssl rand -base64 32
APP_KEY=

# --- Database (SQLite is the simplest for a 4-hour hackathon) ---
DB_CONNECTION=sqlite

# --- Logging / cache / sessions / queue ---
LOG_CHANNEL=stderr
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# --- LLM provider (Gemini is cheap + fast for hackathon judging) ---
GRIDWISE_LLM_DRIVER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# --- Trusted proxies (so Laravel honors X-Forwarded-* from host nginx) ---
TRUSTED_PROXIES=127.0.0.1

# --- Optional tuning ---
APP_LOCALE=en
LOG_LEVEL=info
